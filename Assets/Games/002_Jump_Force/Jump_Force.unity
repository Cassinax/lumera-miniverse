      verticalPillarChance: 0.4
      platformAmplitude: 3
      pillarAmplitude: 1.5
      shortSpecialGapChance: 0.2
      speedMultiplier: 0.85
      speedVariation: 0.6
      reachMargin: 0.8
    - intencao: 'Desafio: menos apoio extra, percursos longos e mais rapidos.'
